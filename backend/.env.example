# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Grab from: Storage Account > Security + networking > Access keys > key1 > Connection string
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY==;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER="uploads"

# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
# Grab from: Cosmos DB > Settings > Keys > Primary Connection String
AZURE_COSMOS_CONNECTION_STRING="AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=YOUR_KEY=="
AZURE_COSMOS_DATABASE="embedbench"

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Grab from: Azure OpenAI > Resource Management > Keys and Endpoint
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com"
AZURE_OPENAI_API_KEY="YOUR_32_CHAR_KEY_HERE"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_LARGE_DEPLOYMENT="text-embedding-3-large"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173"]'
